{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The bundled pages (the splash on desktop, the whole app on mobile)",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-spawn",
    "notification:default",
    "allow-shell-info",
    "allow-set-attention",
    "allow-check-update",
    "allow-install-update",
    "allow-set-autostart"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ]
}
