# Where people reach this hub (used in emails and pairing codes).
CONDUIT_HUB_URL=https://hub.example.com
CONDUIT_HUB_NAME=Example hub
# Becomes the hub admin when it signs up.
CONDUIT_HUB_ADMIN_EMAIL=you@example.com
# true: anyone can sign up. false: only the admin and invited people.
CONDUIT_HUB_OPEN_REGISTRATION=false

# Mail. Each hub sends its own mail; accounts are never shared between hubs.
# console (log only), resend or smtp.
CONDUIT_HUB_MAIL=resend
CONDUIT_HUB_MAIL_FROM=Example hub <hub@example.com>
CONDUIT_HUB_RESEND_KEY=
# CONDUIT_HUB_SMTP_HOST=
# CONDUIT_HUB_SMTP_PORT=587
# CONDUIT_HUB_SMTP_USER=
# CONDUIT_HUB_SMTP_PASSWORD=

# Optional: base64 ed25519 public key release manifests must be signed with,
# if this hub serves an update feed.
CONDUIT_HUB_RELEASE_KEY=

# Optional: serve the public website build from this folder at /.
# CONDUIT_HUB_SITE_DIR=/site

POSTGRES_PASSWORD=change-me
