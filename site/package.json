{
  "name": "@conduit/site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "copy-scripts": "node -e \"for (const f of ['install.sh','install.ps1']) require('fs').copyFileSync('../scripts/'+f, 'public/'+f)\"",
    "build": "pnpm run copy-scripts && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "astro": "^5.18.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "yaml": "2.6.1"
  }
}
