---
import Base from "../layouts/Base.astro";
---
<Base title="Join an organisation">
  <div class="wrap gate">
    <h1>You're invited</h1>
    <p class="muted" id="msg">Sign in with the address the invitation was sent to, then accept it here.</p>
    <div class="row-btns">
      <button class="btn primary" id="accept" hidden>Accept the invitation</button>
      <a class="btn" id="signin" href="/account/">Sign in or create an account</a>
    </div>
    <div class="error" id="err" hidden></div>
  </div>
</Base>
<script>
  import { api, param, token } from "../scripts/hub";
  const t = param("token");
  try {
    if (t) sessionStorage.setItem("conduit.invite", t);
  } catch {}
  const accept = document.getElementById("accept")!;
  if (token()) {
    accept.hidden = false;
    document.getElementById("signin")!.hidden = true;
  }
  accept.onclick = async () => {
    try {
      const r = await api<{ org: string; role: string }>("POST", "/invites/accept", { token: t || sessionStorage.getItem("conduit.invite") });
      document.querySelector("h1")!.textContent = "You've joined";
      document.getElementById("msg")!.textContent = `You're now ${r.role === "admin" ? "an admin" : r.role === "owner" ? "an owner" : "a member"}.`;
      accept.hidden = true;
      document.getElementById("signin")!.hidden = false;
      document.getElementById("signin")!.textContent = "Go to your account";
    } catch (e) {
      const err = document.getElementById("err")!;
      err.textContent = (e as Error).message;
      err.hidden = false;
    }
  };
</script>
<style>
  .row-btns {
    display: flex;
    gap: 12px;
    margin: 24px 0 16px;
    flex-wrap: wrap;
  }
</style>
