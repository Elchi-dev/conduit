---
import Base from "../layouts/Base.astro";
---
<Base page="registry" title="Modules" description="Modules published to this hub, signed by their authors.">
  <div class="wrap reg">
    <h1>Modules on this hub</h1>
    <p class="lede">Published by their authors and signed with their keys. Conduit checks the signature again when it installs a module, so this hub can't change what you get.</p>
    <form id="search" class="search" role="search">
      <label class="field"><span>Search</span><input name="q" placeholder="weather, backup, router…" /></label>
    </form>
    <div id="list" class="list" aria-live="polite"></div>
    <p class="muted small">Publishing: register an author key and publish signed versions with a hub API key. See <a href="/docs/protocol/hub/">the hub protocol</a> and <a href="/docs/protocol/sandbox/">sandboxed modules</a>.</p>
  </div>
</Base>
<script>
  import { api, ago, el } from "../scripts/hub";
  type Pkg = { name: string; owner: string; description: string; latest?: string; downloads: number; updatedAt: string };
  const list = document.getElementById("list")!;
  async function load(q = "") {
    list.replaceChildren(el("p", { class: "muted" }, "Loading…"));
    try {
      const pkgs = await api<Pkg[]>("GET", "/registry/packages" + (q ? "?q=" + encodeURIComponent(q) : ""));
      if (!pkgs.length) return list.replaceChildren(el("p", { class: "muted" }, q ? "Nothing matches." : "No modules published here yet."));
      list.replaceChildren(
        ...pkgs.map((p) =>
          el("div", { class: "pkg" },
            el("div", {}, el("strong", { class: "data" }, p.name), el("p", { class: "muted" }, p.description)),
            el("div", { class: "meta muted small" }, `${p.latest ?? "pre-release"}, updated ${ago(p.updatedAt)}, ${p.downloads} installs`),
          ),
        ),
      );
    } catch (e) {
      list.replaceChildren(el("div", { class: "error" }, (e as Error).message));
    }
  }
  let t: number | undefined;
  (document.querySelector("#search input") as HTMLInputElement).addEventListener("input", (e) => {
    clearTimeout(t);
    t = window.setTimeout(() => load((e.target as HTMLInputElement).value.trim()), 250);
  });
  document.getElementById("search")!.addEventListener("submit", (e) => e.preventDefault());
  load();
</script>
<style>
  .reg {
    padding-top: 56px;
    max-width: 860px;
  }
  h1 {
    font-size: 44px;
    letter-spacing: -0.03em;
    margin: 0 0 14px;
  }
  .lede {
    font-size: 19px;
    color: var(--ink-2);
    max-width: 36em;
  }
  .search {
    margin: 28px 0 8px;
    max-width: 420px;
  }
  .list {
    border-top: 1px solid var(--line);
    margin: 20px 0 28px;
  }
  .small {
    font-size: 14px;
  }
</style>
<style is:global>
  .pkg {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .pkg p {
    margin: 4px 0 0;
  }
  .pkg .meta {
    white-space: nowrap;
  }
  @media (max-width: 600px) {
    .pkg {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
