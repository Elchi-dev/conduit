---
import Base from "../layouts/Base.astro";
import { i18n } from "../i18n";
const { t, l, lang } = i18n(Astro.currentLocale);
const en = lang !== "en" ? "en" : undefined;
const [newA, newB] = t("What's new in each version is in the {link}.").split("{link}");
const [openA, openB] = t("Then open {address} and create the owner account with the setup code from the log.").split("{address}");
const rel = "https://github.com/Elchi-dev/conduit/releases/latest";
const items = [
  ["Windows", t("Installer for Windows 10 and 11. Starts Conduit in the tray and keeps it updated."), "Conduit_x64-setup.exe"],
  ["macOS", t("Apple silicon and Intel. Drag to Applications."), "Conduit_universal.dmg"],
  ["Linux", t("AppImage, .deb and .rpm. The tray needs an app-indicator extension on GNOME."), "Conduit_amd64.AppImage"],
  ["Android", t("Install the APK directly; it isn't in an app store. Pair it with your computer by scanning a code."), "conduit-android.apk"],
];
---
<Base page="download" title={t("Download")} description={t("Download Conduit for Windows, macOS, Linux and Android, or run the daemon on a server.")}>
  <div class="wrap dl">
    <h1>{t("Download Conduit")}</h1>
    <p class="lede">{t("The desktop app runs Conduit on your computer and keeps it up to date. Every update is signed; the app refuses anything else.")}</p>
    <div class="dl-list">
      {items.map(([os, text, file]) => (
        <div class="dl-row">
          <div><h2>{os}</h2><p class="muted">{text}</p></div>
          <a class="btn" href={rel}>{file}</a>
        </div>
      ))}
    </div>

    <p class="muted">{newA}<a href={l("/changelog/")}>{t("changelog")}</a>{newB}</p>

    <h2 class="sub">{t("Servers and headless machines")}</h2>
    <p class="muted">{t("The daemon alone, for a server, a NAS or a Raspberry Pi. One static binary for Linux, macOS and Windows on amd64 and arm64. It updates itself from signed releases and rolls back a version that won't start.")}</p>
    <pre><code>conduitd -listen 0.0.0.0:7600 -data /var/lib/conduit</code></pre>
    <p class="muted">{openA}<span class="data">http://&lt;{t("machine")}&gt;:7600</span>{openB}</p>

    <h2 class="sub">{t("Run a hub")}</h2>
    <p class="muted">{t("A hub lets phones reach your computers from anywhere. Use the default hub, or run your own with Docker.")} <a href="/docs/self-hosting/" hreflang={en}>{t("Self-hosting guide")}</a>.</p>
    <pre><code>docker compose -f deploy/hub/compose.yaml up -d</code></pre>
  </div>
</Base>
<style>
  .dl {
    padding-top: 56px;
    max-width: 860px;
  }
  h1 {
    font-size: 44px;
    letter-spacing: -0.03em;
    margin: 0 0 14px;
  }
  .lede {
    font-size: 19px;
    color: var(--ink-2);
    max-width: 36em;
  }
  .dl-list {
    margin-top: 32px;
    border-top: 1px solid var(--line);
  }
  .dl-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .dl-row h2 {
    margin: 0;
    font-size: 21px;
  }
  .dl-row p {
    margin: 4px 0 0;
    font-size: 16px;
  }
  .sub {
    margin: 56px 0 8px;
    font-size: 24px;
    letter-spacing: -0.02em;
  }
  pre {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 14px 16px;
    overflow-x: auto;
  }
  @media (max-width: 600px) {
    .dl-row {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
