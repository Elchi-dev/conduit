---
import Base from "../layouts/Base.astro";
import { i18n } from "../i18n";
const { t, l, lang } = i18n(Astro.currentLocale);
const en = lang !== "en" ? "en" : undefined;

const [askA, askB] = t("Assistant wants to restart {service}").split("{service}");
const lamps = [t("Mail"), t("Vault"), "web-2", "Docker", t("Game PC"), "Grafana", t("Lights")];

const steps = [
  [t("An agent asks"), t("Your assistant, Claude over MCP, a local model or a script with an API key wants to restart nginx on web-2.")],
  [t("Your rules decide"), t("Reads go through. Writes ask. Anything destructive waits for a person. You choose per agent, per system, per action.")],
  [t("You see the exact change"), t("Not a vague request: the plan says which service, on which server, before and after. Approve from the app, the tray or your phone.")],
  [t("It runs, on the record"), t("Every action lands in a tamper-evident log with who asked and who approved. Most can be undone with one click.")],
];

// The built-in modules (internal/daemon/builtins.go, docs/modules/README.md).
const BUILTIN = 313;

const groups: [string, string[]][] = [
  [t("For developers"), [t("Full GitHub control"), t("Servers over SSH"), "Docker", "Kubernetes", "GitLab", "Gitea and Forgejo", "Linear", "Sentry", t("PostgreSQL and MySQL"), "Redis", "AWS", "Hetzner", "Vercel", "Fly.io", "Cloudflare DNS", t("Prometheus and Grafana"), t("Secrets vault")]],
  [t("For gamers"), [t("Every game in one library"), t("Game mode"), t("Minecraft and Source servers"), "Twitch", "OBS Studio", "Spotify", t("This computer"), "Discord", t("Smart lights"), t("Notifications to your phone")]],
  [t("For homelabs"), [t("WireGuard networks"), "Home Assistant", "Proxmox VE", "TrueNAS", t("Pi-hole and AdGuard"), t("Jellyfin and Plex"), "Tailscale", "UniFi", "Nextcloud", "Ollama", t("Backups with restic"), t("Free space warnings"), t("Ambient status light"), t("Daily brief")]],
  [t("For teams"), [t("Roles and API keys"), t("Approvals with a paper trail"), t("Mail, including Proton Mail"), "Slack", "Jira", "PagerDuty", t("Signed webhooks"), t("Shared hub"), t("Automations"), t("Any MCP server as a module")]],
];

const fresh: [string, string, string?][] = [
  [t("Game library"), t("Steam, Epic, GOG, Battle.net, Xbox and more in one library. Press Play, see what's running, keep your play time.")],
  [t("AI standards"), t("Your code style, design tokens and writing tone, handed to every connected AI automatically.")],
  [t("Marketplace"), t("Modules from the community, signed by their authors and sandboxed, one search away."), "/modules/"],
  [t("WireGuard networks"), t("Reach servers inside a WireGuard network, with no VPN client on the machine."), "/docs/architecture/networks/"],
  [t("Proton Mail"), t("Your Proton mailbox through Proton Mail Bridge, right next to every other inbox."), "/docs/modules/mail/"],
  [t("Full GitHub control"), t("Repositories, pull requests, Actions, releases and settings, all with one token."), "/docs/modules/github/"],
];

const features = [
  [t("Undo everything"), t("Reversible actions come with an Undo button, and the timeline shows what changed.")],
  [t("Dry runs"), t("Agents show the diff first. You approve the diff, not the intent.")],
  [t("Record, then automate"), t("Fix something once by hand, then save those steps as an automation.")],
  [t("What changed?"), t("Pick a moment; see the deploys, config edits, alerts and mail around it.")],
  [t("Emergency stop"), t("One button freezes every agent, key and automation, and denies what's waiting.")],
  [t("Phone as a key"), t("Approving on your phone asks for your fingerprint first.")],
  [t("Leak watch"), t("Finds your secrets in logs, pastes and repos, and rotates them where the service allows.")],
  [t("Game mode"), t("Starting a game pauses heavy work and quiets alerts until you're done.")],
  [t("Ambient status"), t("Green, amber or red on a light, a Stream Deck key or your tray.")],
  [t("Daily brief"), t("Mail, meetings, anything down and anything waiting, in one morning summary.")],
  [t("No hub needed"), t("Pair your phone on the same network and talk to your computer directly.")],
  [t("Sandboxed modules"), t("Untrusted modules run in WebAssembly and reach only the hosts they declare.")],
  [t("Voice"), t("Talk to the assistant; your fingerprint approves what it wants to do.")],
];
---
<Base page="home">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>{t("Your agents do the work.")}<br />{t("You keep the keys.")}</h1>
        <p class="lede">
          {t("Conduit puts your mail, servers, secrets, dashboards, games and home in one place, and lets AI agents work on all of it under rules you set. Every step is shown before it happens and kept on the record after.")}
        </p>
        <div class="cta">
          <a class="btn primary" href={l("/download/")}>{t("Download Conduit")}</a>
          <a class="btn" href="/docs/" hreflang={en}>{t("Read how it works")}</a>
        </div>
        <p class="small muted">{t("Free to run on your own computer. Windows, macOS, Linux and Android.")}</p>
      </div>

      <div class="console" aria-label={t("Conduit asking for approval")}>
        <div class="console-bar">
          <span class="console-brand">
            <svg width="16" height="16" viewBox="0 0 32 32" aria-hidden="true"><path d="M6 10h20M6 16h13M6 22h20" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg>
          </span>
          <ul class="lamps">
            {lamps.map((name, i) => (
              <li class={`lamp ${name === "web-2" ? "lamp-ask" : ""}`} style={`--i:${i}`}>
                <span class="bulb" aria-hidden="true"></span>{name}
              </li>
            ))}
          </ul>
        </div>
        <div class="console-body">
          <div class="ask">
            <div class="ask-head">
              <div>
                <strong>{askA}<span class="data">nginx</span>{askB}</strong>
                <span class="muted small">{t("on web-2, just now")}</span>
              </div>
              <span class="tag">{t("write")}</span>
            </div>
            <div class="diff">
              <div><span class="muted">{t("service")}</span><span class="data">nginx.service</span></div>
              <div><span class="muted">{t("state")}</span><span class="data">failed <span class="arrow">→</span> active</span></div>
              <div><span class="muted">{t("reason")}</span><span>{t("Config fixed in 4f2a1c; health checks failing for 6 minutes")}</span></div>
            </div>
            <div class="ask-actions">
              <span class="muted small">{t("Expires in 15 minutes")}</span>
              <span class="btn sm">{t("Deny")}</span>
              <span class="btn sm signal">{t("Approve")}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="how">
    <div class="wrap">
      <h2>{t("How an agent gets something done")}</h2>
      <ol class="steps">
        {steps.map(([title, text], i) => (
          <li>
            <span class="step-n">{i + 1}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
      <p class="muted how-foot">
        {t("Connect agents however you like: the built-in assistant, any MCP client (Claude Desktop, Claude Code, editors), a local model through Ollama or LM Studio, an API key, or your own endpoint.")}
      </p>
    </div>
  </section>

  <section class="who" id="modules">
    <div class="wrap">
      <h2>{t("Everything you run gets a lamp")}</h2>
      <p class="section-lede">
        {t("{n} built-in modules, a marketplace of signed modules from the community, any MCP server mounted as one, and your own in any language. Pick a starting set when you sign in for the first time.", { n: BUILTIN })}
      </p>

      <div class="fresh" aria-labelledby="fresh-title">
        <h3 id="fresh-title" class="fresh-title">{t("New in Conduit")}</h3>
        <ul class="fresh-list">
          {fresh.map(([title, text, href]) => (
            <li>
              <strong>{href ? <a href={l(href)} hreflang={href.startsWith("/docs/") ? en : undefined}>{title}</a> : title}</strong>
              <span>{text}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="groups">
        {groups.map(([title, items]) => (
          <div class="group">
            <h3>{title}</h3>
            <ul>
              {items.map((it) => <li>{it}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <p class="groups-more">
        <a class="btn" href={l("/modules/")}>{t("Browse the marketplace")}</a>
        <a class="quiet-link" href="/docs/modules/" hreflang={en}>{t("All {n} built-in modules", { n: BUILTIN })}</a>
      </p>
    </div>
  </section>

  <section class="features" id="features">
    <div class="wrap">
      <h2>{t("Thirteen things it does that a dashboard doesn't")}</h2>
      <dl class="feature-list">
        {features.map(([title, text]) => (
          <div>
            <dt>{title}</dt>
            <dd>{text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="hubs">
    <div class="wrap hubs-grid">
      <div>
        <h2>{t("Like git: run it alone, or meet at a hub")}</h2>
        <p>
          {t("Conduit works entirely on your computer. When you want your phone to reach it from anywhere, link it to a hub. The hub only forwards encrypted traffic: it can't read your requests, your secrets or your answers.")}
        </p>
        <p>
          {t("Use the default hub, the one your company runs, or your own. The protocol is open and the hub is one binary with SQLite or PostgreSQL.")}
        </p>
        <a class="btn" href={l("/hub/")}>{t("About hubs")}</a>
      </div>
      <figure class="path" aria-label={t("Phone to hub to computer, encrypted end to end")}>
        <div class="node">{t("Your phone")}</div>
        <div class="wire"><span>{t("encrypted")}</span></div>
        <div class="node node-hub">{t("Any hub")}<small>{t("sees only ciphertext")}</small></div>
        <div class="wire"><span>{t("encrypted")}</span></div>
        <div class="node">{t("Your computer")}</div>
        <figcaption class="muted small">{t("On the same network, the phone skips the hub entirely.")}</figcaption>
      </figure>
    </div>
  </section>
</Base>

<style>
  h1 {
    font-size: clamp(40px, 6vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 800;
    margin: 0 0 22px;
  }
  h2 {
    font-size: clamp(28px, 3.4vw, 40px);
    letter-spacing: -0.025em;
    line-height: 1.1;
    margin: 0 0 18px;
    font-weight: 800;
  }
  h3 {
    margin: 0;
    font-size: 19px;
    letter-spacing: -0.01em;
  }
  .small {
    font-size: 14px;
  }
  section {
    padding: 88px 0 0;
  }
  .hero {
    padding-top: 72px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 56px;
    align-items: center;
  }
  .lede {
    font-size: 20px;
    color: var(--ink-2);
    max-width: 34em;
    margin: 0 0 28px;
  }
  .cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  /* The console: the app's lamp row and an approval card. */
  .console {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    overflow: hidden;
    box-shadow: 0 30px 80px -40px rgb(0 0 0 / 0.6);
  }
  .console-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
  }
  .console-brand {
    color: var(--signal);
    display: flex;
  }
  .lamps {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
  }
  .lamp {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    font-size: 13px;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .bulb {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line-strong);
    flex: none;
    animation: light 0.25s ease-out forwards;
    animation-delay: calc(0.25s + var(--i) * 0.12s);
  }
  @keyframes light {
    to {
      background: var(--ok);
      box-shadow: 0 0 6px color-mix(in srgb, var(--ok) 70%, transparent);
    }
  }
  .lamp-ask .bulb {
    animation: light 0.25s ease-out forwards, ask 0.3s ease-out 1.8s forwards;
  }
  @keyframes ask {
    to {
      background: var(--signal);
      box-shadow: 0 0 8px color-mix(in srgb, var(--signal) 80%, transparent);
    }
  }
  .console-body {
    padding: 22px;
    min-height: 260px;
  }
  .ask {
    border: 1px solid var(--signal);
    border-left-width: 3px;
    border-radius: 10px;
    padding: 16px 18px;
    background: color-mix(in srgb, var(--signal) 5%, var(--panel));
    opacity: 0;
    transform: translateY(8px);
    animation: arrive 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) 2.05s forwards;
  }
  @keyframes arrive {
    to {
      opacity: 1;
      transform: none;
    }
  }
  .ask-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }
  .ask-head strong {
    display: block;
    font-size: 17px;
  }
  .tag {
    align-self: start;
    font-size: 12px;
    padding: 2px 8px;
    border: 1px solid var(--line-strong);
    border-radius: 5px;
    color: var(--ink-2);
  }
  .diff {
    display: grid;
    gap: 6px;
    font-size: 14px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .diff div {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 10px;
  }
  .arrow {
    color: var(--signal);
  }
  .ask-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
  }
  .ask-actions .muted {
    margin-right: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .bulb,
    .lamp-ask .bulb,
    .ask {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .bulb {
      background: var(--ok);
    }
    .lamp-ask .bulb {
      background: var(--signal);
    }
  }

  /* How it works: a real sequence, so it's numbered. */
  .steps {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .steps li {
    padding: 22px 22px 0 0;
    position: relative;
  }
  .steps li + li {
    padding-left: 22px;
    border-left: 1px solid var(--line);
  }
  .step-n {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    font: 500 13px var(--font-data);
    margin-bottom: 14px;
  }
  .steps li:nth-child(3) .step-n {
    border-color: var(--signal);
    color: var(--signal);
  }
  .steps p {
    color: var(--ink-2);
    font-size: 16px;
    margin: 8px 0 0;
  }
  .how-foot {
    margin-top: 28px;
    max-width: 52em;
    font-size: 16px;
  }

  .section-lede {
    color: var(--ink-2);
    max-width: 40em;
    margin: 0 0 32px;
  }
  /* What's new: one quiet band above the groups. */
  .fresh {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
    padding: 20px 22px 6px;
    margin: 0 0 40px;
  }
  .fresh-title {
    font-size: 13px;
    font-family: var(--font-data);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 14px;
  }
  .fresh-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 32px;
  }
  .fresh-list li {
    display: grid;
    gap: 2px;
    padding: 0 0 16px;
  }
  .fresh-list strong a {
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  .fresh-list span {
    color: var(--ink-2);
    font-size: 15px;
  }
  .groups-more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin: 32px 0 0;
  }
  .quiet-link {
    color: var(--ink-2);
    font-size: 15px;
    text-underline-offset: 3px;
  }
  .groups {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
  }
  .group ul {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    display: grid;
    gap: 8px;
    color: var(--ink-2);
    font-size: 16px;
  }
  .group li::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ok);
    margin: 0 10px 2px 0;
  }

  .feature-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 26px 40px;
    margin: 32px 0 0;
  }
  .feature-list dt {
    font-weight: 700;
    margin-bottom: 4px;
  }
  .feature-list dd {
    margin: 0;
    color: var(--ink-2);
    font-size: 16px;
  }

  .hubs-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }
  .hubs p {
    color: var(--ink-2);
    max-width: 34em;
  }
  .path {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr auto 1.2fr auto 1fr;
    align-items: center;
    gap: 0;
  }
  .node {
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    padding: 18px 12px;
    text-align: center;
    font-weight: 600;
    background: var(--panel);
  }
  .node small {
    display: block;
    font-weight: 400;
    color: var(--muted);
    font-size: 13px;
    margin-top: 4px;
  }
  .node-hub {
    border-style: dashed;
  }
  .wire {
    height: 2px;
    width: 88px;
    background: var(--ok);
    position: relative;
  }
  .wire span {
    position: absolute;
    top: -20px;
    left: 50%;
    transform: translateX(-50%);
    font: 10px var(--font-data);
    color: var(--muted);
  }
  .path figcaption {
    grid-column: 1 / -1;
    margin-top: 16px;
    text-align: center;
  }

  @media (max-width: 960px) {
    .hero-grid,
    .hubs-grid {
      grid-template-columns: 1fr;
    }
    .steps,
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .steps li:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .feature-list,
    .fresh-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    section {
      padding-top: 64px;
    }
    .steps,
    .groups,
    .feature-list,
    .fresh-list {
      grid-template-columns: 1fr;
    }
    .steps li + li {
      border-left: 0;
      padding-left: 0;
    }
    .steps li {
      border-bottom: 1px solid var(--line);
      padding-bottom: 18px;
    }
    .path {
      grid-template-columns: 1fr;
      justify-items: stretch;
    }
    .wire {
      width: 2px;
      height: 36px;
      justify-self: center;
    }
    .wire span {
      top: 50%;
      left: 12px;
      transform: translateY(-50%);
    }
    .diff div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
